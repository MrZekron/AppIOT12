<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.AppIOT12.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/color_primary</item>
        <item name="android:textColor">@color/color_text_on_primary</item>
    </style>

    <style name="Widget.AppIOT12.Button.Secondary" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/color_secondary</item>
        <item name="android:textColor">@color/color_text_on_primary</item>
    </style>

    <style name="Widget.AppIOT12.Button.Danger" parent="Widget.AppIOT12.Button">
        <item name="backgroundTint">@color/color_error</item>
    </style>

    <style name="Widget.AppIOT12.Button.Dark" parent="Widget.AppIOT12.Button">
        <item name="backgroundTint">@color/color_primary_dark</item>
    </style>

    <style name="Widget.AppIOT12.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/color_link</item>
    </style>

    <style name="Widget.AppIOT12.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/card_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/card_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/card_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/card_corner_radius</item>
        <item name="boxStrokeColor">@color/color_primary</item>
        <item name="hintTextColor">@color/color_text_hint</item>
    </style>

</resources>
