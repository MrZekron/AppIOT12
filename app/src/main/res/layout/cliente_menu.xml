<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_with_logo"
    tools:context=".Menu">

    <!-- ========================= -->
    <!-- 🔝 BARRA SUPERIOR USUARIO -->
    <!-- ========================= -->
    <LinearLayout
        android:id="@+id/navCuenta"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/color_nav_overlay"
        android:onClick="abrirConfiguracion"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivUsuario"
            android:layout_width="45dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_logo"
            android:contentDescription="Usuario"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/logo2" />

        <TextView
            android:id="@+id/tvCorreoUsuario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="correo@ejemplo.com"
            android:textSize="16sp"
            android:textColor="@color/color_text_on_dark"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnToggleTema"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cambiar tema"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_modo_oscuro"
            app:tint="@color/color_text_on_dark" />
    </LinearLayout>

    <!-- ========================= -->
    <!-- 🏷️ TÍTULO -->
    <!-- ========================= -->
    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Menú Principal"
        android:textSize="34sp"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/navCuenta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ========================= -->
    <!-- 📦 BOTONES – FILA 1 -->
    <!-- ========================= -->
    <Button
        android:id="@+id/btnLista"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:text="Lista de Tanques"
        android:textColor="@color/color_text_on_dark"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/color_primary"
        android:onClick="lista"
        android:layout_margin="10dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnAgregar"/>

    <Button
        android:id="@+id/btnAgregar"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:text="Agregar Tanque"
        android:textColor="@color/color_text_on_dark"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/color_primary"
        android:onClick="agregar"
        android:layout_margin="10dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo"
        app:layout_constraintStart_toEndOf="@id/btnLista"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ========================= -->
    <!-- 💳 BOTONES – FILA 2 -->
    <!-- ========================= -->
    <Button
        android:id="@+id/btnPagosUsuario"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:text="Mis Pagos"
        android:textColor="@color/color_text_on_dark"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/color_primary"
        android:onClick="pagos"
        android:layout_margin="10dp"
        app:layout_constraintTop_toBottomOf="@id/btnLista"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnComprarDispositivo"/>

    <Button
        android:id="@+id/btnComprarDispositivo"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:text="Comprar Dispositivo"
        android:textColor="@color/color_text_on_dark"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/color_primary"
        android:onClick="comprarDispositivo"
        android:layout_margin="10dp"
        app:layout_constraintTop_toBottomOf="@id/btnAgregar"
        app:layout_constraintStart_toEndOf="@id/btnPagosUsuario"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ========================= -->
    <!-- 🔗 BOTONES – FILA 3 -->
    <!-- ========================= -->
    <Button
        android:id="@+id/btnAsociarDispositivo"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:text="Asociar Dispositivo"
        android:textColor="@color/color_text_on_dark"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/color_primary"
        android:onClick="asociarDispositivo"
        android:layout_margin="10dp"
        app:layout_constraintTop_toBottomOf="@id/btnPagosUsuario"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ========================= -->
    <!-- 🚪 SALIR -->
    <!-- ========================= -->
    <Button
        android:id="@+id/btnSalir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cerrar Sesión"
        android:textColor="@color/color_text_on_dark"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/color_secondary"
        android:onClick="salir"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/btnAsociarDispositivo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
