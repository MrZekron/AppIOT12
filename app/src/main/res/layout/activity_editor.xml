<?xml version="1.0" encoding="utf-8"?>
<?xml version="1.0" encoding="utf-8"?>
<!--
    Pantalla de edición de tanque.
    - El formulario está dentro de un contenedor con margen.
    - Los botones están fuera del formulario para que puedas
      moverlos y ajustar su tamaño más fácilmente.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    tools:context=".Editor">

    <TextView
        android:id="@+id/tvTituloConfig"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Editor de Tanque"
        android:textSize="36sp"
        android:textColor="@color/color_text_primary"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        CONTENEDOR DEL FORMULARIO
        Aquí se agrupan los campos para que tengan un margen general
        respecto a los bordes de la pantalla.
    -->

    <!--
        BOTÓN GUARDAR
        Está fuera del formulario para que puedas moverlo o cambiarle
        el tamaño manualmente sin afectar el contenedor.
    -->

    <LinearLayout
        android:id="@+id/contenedorFormulario"
        android:layout_width="334dp"
        android:layout_height="224dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="132dp"
        android:layout_marginEnd="24dp"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.482"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!--
            Campo para ingresar o editar el nombre del tanque.
        -->
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Nombre del Tanque"
            android:inputType="text"
            android:minHeight="48dp" />

        <!--
            Campo para ingresar o editar la capacidad del tanque en litros.
        -->
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etCapacidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Capacidad (L)"
            android:inputType="number"
            android:minHeight="48dp" />

        <!--
            Campo para ingresar o editar el color del tanque.
        -->
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Color del Tanque"
            android:inputType="text"
            android:minHeight="48dp" />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnGuardar"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:onClick="guardarTanque"
        android:backgroundTint="@color/color_primary"
        android:text="Guardar Cambios"
        android:textColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/contenedorFormulario"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        BOTÓN VOLVER
        También está fuera del formulario para que lo puedas ajustar
        libremente después.
    -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnVolver"
        android:layout_width="203dp"
        android:layout_height="43dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/color_secondary"
        android:onClick="volverAlMenu"
        android:text="Volver"
        android:textColor="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnGuardar" />

</androidx.constraintlayout.widget.ConstraintLayout>
