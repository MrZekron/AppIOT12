<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout de la pantalla Gestión de Usuarios.
    Se organiza con ConstraintLayout para que los elementos
    se acomoden correctamente en distintas pantallas.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_with_logo"
    tools:context=".GestionUsuarios">

    <!--
        Título principal de la pantalla.
        Está centrado en la parte superior.
    -->
    <TextView
        android:id="@+id/tvTituloUsuarios"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Gestión de Usuarios"
        android:textColor="@color/color_text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        Botón para filtrar usuarios.
        Se ubica debajo del título y centrado.
    -->
    <com.google.android.material.button.MaterialButton
        style="@style/Widget.AppIOT12.Button"
        android:id="@+id/btnFiltrarUsuarios"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="10dp"
        android:text="Filtrar usuarios"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tvTituloUsuarios"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        Botón para asignar un dispositivo a un usuario.
        Se ubica debajo del botón filtrar.
    -->
    <com.google.android.material.button.MaterialButton
        style="@style/Widget.AppIOT12.Button.Secondary"
        android:id="@+id/btnAsignarDispositivo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Asignar Dispositivo"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/btnFiltrarUsuarios"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        Lista de usuarios.
        Ocupa todo el espacio disponible entre el botón de asignar
        y el botón volver.
    -->
    <ListView
        android:id="@+id/listUsuarios"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_card"
        android:dividerHeight="8dp"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnAsignarDispositivo"
        app:layout_constraintBottom_toTopOf="@id/btnVolver"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        Botón para volver a la pantalla anterior.
        Se fija en la parte inferior del layout.
    -->
    <com.google.android.material.button.MaterialButton
        style="@style/Widget.AppIOT12.Button.Dark"
        android:id="@+id/btnVolver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:onClick="volver"
        android:padding="10dp"
        android:text="Volver"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <include
        android:id="@+id/includeToolbarTema"
        layout="@layout/include_toolbar_tema"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
