<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@drawable/bg_screen_with_logo"
    tools:context=".MenuAdmin">

    <!-- TÍTULO -->
    <include
        android:id="@+id/includeToolbarTema"
        layout="@layout/include_toolbar_tema"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTituloAdmin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Panel Administrador"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- BOTÓN: Gestionar usuarios -->
    <com.google.android.material.button.MaterialButton
        style="@style/Widget.AppIOT12.Button"
        android:id="@+id/btnGestionUsuarios"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Gestionar Usuarios"
        android:padding="12dp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@+id/tvTituloAdmin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ⭐ NUEVO BOTÓN: Historial Global -->
    <com.google.android.material.button.MaterialButton
        style="@style/Widget.AppIOT12.Button"
        android:id="@+id/btnHistorialGlobal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Historial Global"
        android:padding="12dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/btnGestionUsuarios"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- BOTÓN: Configuración -->
    <com.google.android.material.button.MaterialButton
        style="@style/Widget.AppIOT12.Button"
        android:id="@+id/btnConfigAdmin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Configuración"
        android:padding="12dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/btnHistorialGlobal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ====================================================
         📊 BOTÓN: Gráficos Estadísticos
         Abre GraficosAdmin.java donde el admin puede ver:
         - Usuarios registrados por mes
         - Compras de dispositivos por mes (global)
         - Compras de dispositivos por usuario
         Usa @color/color_primary (#1D8EC1) igual que Agregar.xml
         ==================================================== -->
    <com.google.android.material.button.MaterialButton
        style="@style/Widget.AppIOT12.Button"
        android:id="@+id/btnGraficos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Ver Gráficos 📊"
        android:padding="12dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/btnConfigAdmin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
