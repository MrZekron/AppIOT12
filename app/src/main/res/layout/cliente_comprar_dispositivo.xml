<?xml version="1.0" encoding="utf-8"?>
<!--
    Pantalla para solicitar la compra del dispositivo.
    Muestra el producto, el precio, cuotas referenciales
    y permite crear la compra para luego ir a transferencia.
-->

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:padding="24dp"
    tools:context=".ComprarDispositivo">

    <!-- Título -->
    <TextView
        android:id="@+id/tvTituloCompra"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Comprar Dispositivo"
        android:textColor="@color/color_text_primary"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Tarjeta principal -->
    <LinearLayout
        android:id="@+id/cardCompra"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@color/color_secondary"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTituloCompra">

        <!-- Descripción -->
        <TextView
            android:id="@+id/tvDescripcion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Solicita tu dispositivo y continúa el pago por transferencia."
            android:textColor="#333"
            android:textSize="16sp" />

        <!-- Precio -->
        <TextView
            android:id="@+id/tvPrecio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Precio: $0"
            android:textColor="#1A237E"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Etiqueta cuotas -->
        <TextView
            android:id="@+id/tvCuotas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Cuotas referenciales:"
            android:textColor="#333"
            android:textSize="16sp" />

        <!-- Selector de cuotas -->
        <Spinner
            android:id="@+id/spnCuotas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:entries="@array/cuotas_array"
            android:minHeight="48dp" />

        <!-- Resumen -->
        <TextView
            android:id="@+id/tvResumenCuota"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Cuota referencial: $0"
            android:textColor="#004D40"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Nota -->
        <TextView
            android:id="@+id/tvNotaCompra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Después de confirmar, verás los datos para transferir y enviar tu comprobante por WhatsApp."
            android:textColor="#444"
            android:textSize="14sp" />

        <!-- Botón comprar -->
        <Button
            android:id="@+id/btnComprar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/color_primary"
            android:padding="16dp"
            android:text="Continuar compra"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
