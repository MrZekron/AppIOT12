<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/fondo"
    tools:context=".Menu">

    <!-- ========================= -->
    <!-- 🔝 BARRA SUPERIOR USUARIO -->
    <!-- ========================= -->
    <LinearLayout
        android:id="@+id/navCuenta"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#33000000"
        android:onClick="abrirConfiguracion"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivUsuario"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Usuario" />

        <TextView
            android:id="@+id/tvCorreoUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="correo@ejemplo.com"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ========================= -->
    <!-- 🏷️ TÍTULO -->
    <!-- ========================= -->
    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Menú Principal"
        android:textSize="34sp"
        android:textStyle="bold"
        android:textColor="#263238"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/navCuenta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ========================= -->
    <!-- 📦 BOTONES – FILA 1 -->
    <!-- ========================= -->
    <Button
        android:id="@+id/btnLista"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:text="Lista de Tanques"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#1565C0"
        android:onClick="lista"
        android:layout_margin="10dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnAgregar"/>

    <Button
        android:id="@+id/btnAgregar"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:text="Agregar Tanque"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#2E7D32"
        android:onClick="agregar"
        android:layout_margin="10dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo"
        app:layout_constraintStart_toEndOf="@id/btnLista"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ========================= -->
    <!-- 💳 BOTONES – FILA 2 -->
    <!-- ========================= -->
    <Button
        android:id="@+id/btnPagosUsuario"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:text="Mis Pagos"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#00695C"
        android:onClick="pagos"
        android:layout_margin="10dp"
        app:layout_constraintTop_toBottomOf="@id/btnLista"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnComprarDispositivo"/>

    <Button
        android:id="@+id/btnComprarDispositivo"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:text="Comprar Dispositivo"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#283593"
        android:onClick="comprarDispositivo"
        android:layout_margin="10dp"
        app:layout_constraintTop_toBottomOf="@id/btnAgregar"
        app:layout_constraintStart_toEndOf="@id/btnPagosUsuario"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ========================= -->
    <!-- 🔗 BOTONES – FILA 3 -->
    <!-- ========================= -->
    <Button
        android:id="@+id/btnAsociarDispositivo"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:text="Asociar Dispositivo"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#6A1B9A"
        android:onClick="asociarDispositivo"
        android:layout_margin="10dp"
        app:layout_constraintTop_toBottomOf="@id/btnPagosUsuario"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnCentroPagos"/>

    <Button
        android:id="@+id/btnCentroPagos"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:text="Centro de Pagos"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#00838F"
        android:onClick="centroPagos"
        android:layout_margin="10dp"
        app:layout_constraintTop_toBottomOf="@id/btnComprarDispositivo"
        app:layout_constraintStart_toEndOf="@id/btnAsociarDispositivo"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ========================= -->
    <!-- 🚪 SALIR -->
    <!-- ========================= -->
    <Button
        android:id="@+id/btnSalir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cerrar Sesión"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#C62828"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/btnCentroPagos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
