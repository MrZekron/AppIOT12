<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_with_logo"
    android:padding="24dp">

    <include
        android:id="@+id/includeToolbarTema"
        layout="@layout/include_toolbar_tema"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTituloConfirmar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Comprobantes Pendientes"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/includeToolbarTema"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvSubtitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Confirmá o rechazá cada transferencia enviada."
        android:textSize="13sp"
        android:textColor="@color/color_text_secondary"
        android:layout_marginTop="4dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvTituloConfirmar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ListView
        android:id="@+id/lvComprobantes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:dividerHeight="1dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitulo"
        app:layout_constraintBottom_toTopOf="@id/btnVolverConfirmar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        style="@style/Widget.AppIOT12.Button.Secondary"
        android:id="@+id/btnVolverConfirmar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Volver"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
