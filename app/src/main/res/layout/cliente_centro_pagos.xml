<?xml version="1.0" encoding="utf-8"?>
<!--
    Pantalla de pagos por transferencia.
    Muestra los datos de la compra, los datos bancarios
    y un botón para enviar comprobante por WhatsApp.
-->

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_with_logo"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <include layout="@layout/include_toolbar_tema" />

        <!-- Título principal -->
        <TextView
            android:id="@+id/tvTituloPagos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Centro de Pagos"
            android:textColor="@color/color_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Tarjeta con datos de la compra -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvProductoPago"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Producto: Dispositivo AguaSegura"
                android:textColor="#000"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvMontoPago"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Monto: $0"
                android:textColor="#000"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvCodigoPedido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Código de pedido: AGS-0000"
                android:textColor="#000"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Tarjeta con datos de transferencia -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Datos para transferencia"
                android:textColor="#000"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBanco"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Banco: Mercado Pago"
                android:textColor="#000"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvTipoCuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tipo de cuenta: Cuenta Vista"
                android:textColor="#000"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvNumeroCuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="N° de cuenta: 1085751669"
                android:textColor="#000"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvTitular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Titular: Moisés Bensaid Cid Valenzuela"
                android:textColor="#000"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvRut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="RUT: 21.503.331-7"
                android:textColor="#000"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvCorreoPago"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Correo: cidm3965@gmail.com"
                android:textColor="#000"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Botón para abrir WhatsApp -->
        <com.google.android.material.button.MaterialButton
        style="@style/Widget.AppIOT12.Button"
            android:id="@+id/btnEnviarWhatsapp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="12dp"
            android:text="Enviar comprobante por WhatsApp"
            android:textStyle="bold" />

        <!-- Botón para volver -->
        <com.google.android.material.button.MaterialButton
        style="@style/Widget.AppIOT12.Button"
            android:id="@+id/btnVolverMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="12dp"
            android:text="Volver"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
