<?xml version="1.0" encoding="utf-8"?>
<!--
    Pantalla para agregar un tanque.

    ¿Qué hace este XML?
    1. Muestra formulario para crear un tanque
    2. Permite ingresar nombre y capacidad
    3. Permite elegir color con Spinner
    4. Permite escribir una dirección manualmente
    5. Tiene un botón para validar dirección con Google Places
    6. Tiene botones para volver o agregar
-->

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_with_logo"
    android:padding="16dp"
    tools:context=".Agregar">

    <!-- Título principal -->
    <TextView
        android:id="@+id/tvTituloAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Agregar Tanque de Agua"
        android:textColor="@color/color_text_primary"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Formulario principal -->
    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTituloAdd">

        <!-- Nombre del tanque -->
        <EditText
            android:textColorHint="@color/color_text_hint"
            android:background="@drawable/bg_input_field"
            android:id="@+id/txtNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Nombre"
            android:inputType="textCapSentences"
            android:minHeight="48dp"
            android:padding="12dp"
            android:textColor="@color/color_secondary"
            android:textSize="16sp" />

        <!-- Capacidad -->
        <EditText
            android:textColorHint="@color/color_text_hint"
            android:background="@drawable/bg_input_field"
            android:id="@+id/txtCapasidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Capacidad Volumétrica"
            android:inputType="number"
            android:maxLength="6"
            android:minHeight="48dp"
            android:padding="12dp"
            android:textColor="@color/color_secondary"
            android:textSize="16sp" />

        <!-- Color -->
        <Spinner
            android:id="@+id/spnColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp" />

        <!-- Dirección -->
        <EditText
            android:textColorHint="@color/color_text_hint"
            android:background="@drawable/bg_input_field"
            android:id="@+id/txtDireccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Ingrese dirección real"
            android:inputType="textPostalAddress"
            android:minHeight="48dp"
            android:padding="12dp"
            android:textColor="@color/color_secondary"
            android:textSize="16sp" />

        <!-- Botón validar dirección -->
        <com.google.android.material.button.MaterialButton
        style="@style/Widget.AppIOT12.Button"
            android:id="@+id/btnValidarDireccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:onClick="validarDireccion"
            android:text="Validar dirección"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Botones inferiores -->
    <LinearLayout
        android:id="@+id/layoutBotones"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/linearLayout">

        <!-- Volver -->
        <com.google.android.material.button.MaterialButton
        style="@style/Widget.AppIOT12.Button"
            android:id="@+id/btnVolver"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:onClick="cancelar"
            android:text="Volver"
            android:textSize="16sp" />

        <!-- Agregar -->
        <com.google.android.material.button.MaterialButton
        style="@style/Widget.AppIOT12.Button"
            android:id="@+id/btnAgregar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:onClick="enviarDatosUsuario"
            android:text="Agregar"
            android:textSize="16sp" />
    </LinearLayout>


    <include
        android:id="@+id/includeToolbarTema"
        layout="@layout/include_toolbar_tema"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
