<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvDescripcionPago"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Dispositivo AguaSegura"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnPagarCuota" />

    <TextView
        android:id="@+id/tvCuotasStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Cuotas: 0/1 pagadas"
        android:textSize="13sp"
        android:textColor="@color/color_text_secondary"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvDescripcionPago"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnPagarCuota" />

    <TextView
        android:id="@+id/tvMontoPago"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Saldo: $0"
        android:textSize="13sp"
        android:textColor="@color/color_text_primary"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/tvCuotasStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnPagarCuota" />

    <TextView
        android:id="@+id/tvEstadoPago"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Pendiente"
        android:textSize="13sp"
        android:textColor="@color/color_error"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvMontoPago"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnPagarCuota"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- hidden field kept for date compatibility -->
    <TextView
        android:id="@+id/tvFechaPago"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        style="@style/Widget.AppIOT12.Button"
        android:id="@+id/btnPagarCuota"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pagar cuota"
        android:textSize="13sp"
        android:padding="10dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
