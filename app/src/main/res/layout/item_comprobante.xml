<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvComprobanteProducto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Cuota 1 — Dispositivo AguaSegura"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvComprobanteUsuario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Usuario: —"
        android:textSize="13sp"
        android:textColor="@color/color_text_secondary"
        android:layout_marginTop="3dp"
        app:layout_constraintTop_toBottomOf="@id/tvComprobanteProducto"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvComprobanteMonto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Monto: $0"
        android:textSize="14sp"
        android:textColor="@color/color_primary"
        android:textStyle="bold"
        android:layout_marginTop="3dp"
        app:layout_constraintTop_toBottomOf="@id/tvComprobanteUsuario"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        style="@style/Widget.AppIOT12.Button"
        android:id="@+id/btnConfirmar"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:text="Confirmar"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvComprobanteMonto"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnRechazar"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.google.android.material.button.MaterialButton
        style="@style/Widget.AppIOT12.Button.Danger"
        android:id="@+id/btnRechazar"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:text="Rechazar"
        android:layout_marginTop="8dp"
        android:layout_marginStart="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvComprobanteMonto"
        app:layout_constraintStart_toEndOf="@id/btnConfirmar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
