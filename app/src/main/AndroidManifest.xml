<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- ========================= -->
    <!-- 🌐 PERMISOS -->
    <!-- ========================= -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" /> <!-- Caché mapas (OSMDroid / Geocoder) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".AppIOT12Application"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppIOT12"
        tools:targetApi="31">
        <activity
            android:name="com.example.appiot12.ui.perfil.EditorPerfil"
            android:exported="false" />
        <!-- ========================= -->
        <!-- 🧭 NAVEGACIÓN / MAPAS -->
        <!-- ========================= -->
        <activity
            android:name="com.example.appiot12.ui.maps.MapaDireccionActivity"
            android:exported="false" /> <!-- ========================= -->
        <!-- 💧 TANQUES -->
        <!-- ========================= -->
        <activity
            android:name="com.example.appiot12.ui.tanque.Agregar"
            android:exported="false" />
        <activity
            android:name="com.example.appiot12.ui.tanque.Lista"
            android:exported="false" />
        <activity
            android:name="com.example.appiot12.ui.tanque.ListaGlobalTanques"
            android:exported="false" /> <!-- ========================= -->
        <!-- 🤖 DISPOSITIVOS -->
        <!-- ========================= -->
        <activity
            android:name="com.example.appiot12.ui.pago.ComprarDispositivo"
            android:exported="false" />
        <activity
            android:name="com.example.appiot12.ui.tanque.AsociarDispositivoATanque"
            android:exported="false" /> <!-- ========================= -->
        <!-- 💳 PAGOS -->
        <!-- ========================= -->
        <activity
            android:name="com.example.appiot12.ui.pago.CentroPagos"
            android:exported="false" />
        <activity
            android:name="com.example.appiot12.ui.pago.HistorialCompra"
            android:exported="false" /> <!-- ========================= -->
        <!-- 👤 USUARIO -->
        <!-- ========================= -->
        <activity
            android:name="com.example.appiot12.ui.auth.IniciarSesion"
            android:exported="false" />
        <activity
            android:name="com.example.appiot12.ui.auth.CrearCuentaActivity"
            android:exported="false" />
        <activity
            android:name="com.example.appiot12.ui.auth.OlvideContrasenaActivity"
            android:exported="false" /> <!-- ========================= -->
        <!-- ⚙️ ADMIN / CONFIG -->
        <!-- ========================= -->
        <activity
            android:name="com.example.appiot12.ui.menu.Menu"
            android:exported="false" />
        <activity
            android:name="com.example.appiot12.ui.menu.MenuAdmin"
            android:exported="false" />
        <activity
            android:name="com.example.appiot12.ui.perfil.Configuracion"
            android:exported="false" />
        <activity
            android:name="com.example.appiot12.ui.perfil.Informacion"
            android:exported="false" />
        <activity
            android:name="com.example.appiot12.ui.tanque.Editor"
            android:exported="false" />
        <activity
            android:name="com.example.appiot12.ui.admin.GestionUsuarios"
            android:exported="false" />
        <activity
            android:name="com.example.appiot12.ui.admin.HistorialAcciones"
            android:exported="false" />
        <activity
            android:name="com.example.appiot12.ui.admin.HistorialGlobal"
            android:exported="false" />
        <!-- 📊 Pantalla de gráficos estadísticos del administrador -->
        <activity
            android:name="com.example.appiot12.ui.admin.GraficosAdmin"
            android:exported="false" /> <!-- ========================= -->
        <!-- 🔔 FCM -->
        <service
            android:name="com.example.appiot12.service.MiFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- 🚀 MAIN -->
        <!-- ========================= -->
        <activity
            android:name="com.example.appiot12.ui.menu.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>